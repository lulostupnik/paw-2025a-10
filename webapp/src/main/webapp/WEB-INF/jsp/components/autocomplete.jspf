<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="form" uri="http://www.springframework.org/tags/form" %>
<%@ taglib prefix="spring" uri="http://www.springframework.org/tags" %>

<%--
  Parámetros esperados:
    inputId: ID base (ej: "career")
    path: path del form
    items: lista de objetos
    labelCode: código i18n del label
    placeholderCode: código i18n del placeholder
    selectedId: ID del contenedor de selección (opcional)
    formGroupClass: clases adicionales para el form-group (opcional)
    required: "true" si debe agregarse required-field y required-selected-tags
--%>

<div class="form-group ${formGroupClass}">
  <form:label path="${path}" cssClass="form-label ${required == 'true' ? 'required-field' : ''}">
    <spring:message code="${labelCode}"/>
  </form:label>
  <div class="autocomplete-wrapper">
    <select id="${inputId}" class="form-select ${not empty errors.getFieldError(path) ? 'error' : ''}" style="display: none;">
      <option value=""><spring:message code="${labelCode}.select"/></option>
      <c:forEach var="item" items="${items}">
        <option value="${item.name}"><c:out value="${item.name}"/></option>
      </c:forEach>
    </select>

    <c:set var="searchPlaceholder"><spring:message code="${placeholderCode}" text="Type to search..."/></c:set>
    <form:input type="text" path="${path}" id="${inputId}Search"
                class="autocomplete-input ${not empty errors.getFieldError(path) ? 'error' : ''}"
                placeholder="${searchPlaceholder}" />

    <div id="${inputId}Dropdown" class="autocomplete-dropdown" style="display: none;">
      <c:forEach var="item" items="${items}">
        <div class="autocomplete-item" data-value="${item.name}">
          <c:out value="${item.name}"/>
        </div>
      </c:forEach>
    </div>

    <div id="${selectedId}" class="selected-tags ${required == 'true' ? 'required-selected-tags' : ''}"></div>
  </div>

  <form:errors path="${path}" cssClass="error-message" />
</div>
